# Copie estes nomes para Vercel → Project Settings → Environment Variables.
# Nunca preencha valores reais aqui — este arquivo é versionado no git.

# Wix dashboard → Settings → API Keys (permissão "Manage Data Items")
WIX_API_KEY=

# Wix dashboard → Settings → informações gerais do site
WIX_SITE_ID=

# Só necessário se o teste de curl do passo A0 retornar 401 pedindo
# uma conta — nesse caso a API Key é de nível "conta", não "site".
WIX_ACCOUNT_ID=

# Chave do campo multi-referência em Usuarios que lista os Apps
# acessíveis por cada usuário — confirme em Content Manager (ver
# tutorial de setup) antes de preencher. Ex.: "apps" ou "import3_usuario".
WIX_USER_APPS_FIELD=
